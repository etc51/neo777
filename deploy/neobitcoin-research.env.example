TRADING_MODE=readonly
REAL_ORDERS_ENABLED=false
LIVE_TRADING_ENABLED=false
NEO_TRADER_LIVE_TRADING_ENABLED=false
NEO_TRADER_TRADING_MODE=readonly
NEOBITCOIN_RESEARCH_TOKEN_FILE=/etc/neobitcoin-research/tbank.token
NEOBITCOIN_RESEARCH_DATA=/var/lib/neobitcoin-research
NEOBITCOIN_RESEARCH_REPORTS=/var/lib/neobitcoin-research/reports
NEOBITCOIN_RESEARCH_INSTRUMENT=Neo Bitcoin
NEOBITCOIN_RESEARCH_DEPTH=50
NEOBITCOIN_RESEARCH_EXPERIMENT_ID=directional-edge-v1
# Set 0.045 + current CBR key rate for cross-midnight perpetual positions.
# When unset, cross-midnight outcomes are marked INVALID_DATA.
PYTHONUNBUFFERED=1
