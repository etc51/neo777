[Unit]
Description=neo_swarm_scalper NEOBITOK/NEOEFIR dashboard
After=network-online.target neo-swarm-bot.service
Wants=network-online.target

[Service]
Type=simple
User=neo-trader
Group=neo-trader
WorkingDirectory=/opt/neo_trader
EnvironmentFile=/etc/neo-trader/neo-swarm-scalper.env
Environment=REAL_TRADING_ENABLED=false
Environment=ALLOW_REAL_ORDERS=false
Environment=PAPER_LIVE_DATA_ONLY=true
ExecStart=/opt/neo_trader/.venv/bin/python -m streamlit run neo_swarm_scalper/dashboard.py --server.port 8025 --server.address 0.0.0.0 --server.headless true -- --db data/neo_swarm_scalper.sqlite
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
