[Unit]
Description=neo_swarm_scalper NEOBITOK Streamlit dashboard
After=network-online.target neo-swarm-scalper.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=neo-trader
Group=neo-trader
WorkingDirectory=/opt/neo_trader
EnvironmentFile=/etc/neo-trader/neo-swarm-scalper.env
Environment=REAL_TRADING_ENABLED=false
Environment=ALLOW_REAL_ORDERS=false
Environment=PAPER_LIVE_DATA_ONLY=true
Environment=HOME=/var/lib/neo-swarm-scalper
StateDirectory=neo-swarm-scalper
UMask=0077
ExecStart=/opt/neo_trader/.venv/bin/python -m streamlit run neo_swarm_scalper/dashboard.py --server.port 8025 --server.address 0.0.0.0 --server.headless true -- --db /var/lib/neo-swarm-scalper/neo_swarm_scalper.sqlite
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
