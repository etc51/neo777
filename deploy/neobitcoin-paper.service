[Unit]
Description=Neobitcoin paper-only trading runtime
Documentation=file:/opt/neobitcoin-paper/docs/paper_bot_operations.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/neobitcoin-paper
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60s
WatchdogSignal=SIGTERM
User=neopaper
Group=neopaper
WorkingDirectory=/opt/neobitcoin-paper
EnvironmentFile=/etc/neobitcoin-paper/paper.env
Environment=PAPER_ONLY=true
Environment=NEOBITCOIN_PAPER_DATA=/var/lib/neobitcoin-paper
Environment=NEOBITCOIN_PAPER_TOKEN_FILE=%d/tbank-token.txt
Environment=NEOBITCOIN_PAPER_HEALTH_HOST=127.0.0.1
Environment=NEOBITCOIN_PAPER_HEALTH_PORT=8787
LoadCredential=tbank-token.txt:/etc/neobitcoin-paper/tbank-token
ExecStart=/usr/bin/env PAPER_ONLY=true /opt/neobitcoin-paper/.venv/bin/python -m neobitcoin_paper.cli run --confirm PAPER_ONLY
Restart=always
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=90s
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
KillMode=mixed
SendSIGKILL=true
UMask=0077
RuntimeDirectory=neobitcoin-paper
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/neobitcoin-paper /etc/neobitcoin-paper
ReadWritePaths=/var/lib/neobitcoin-paper/state /var/lib/neobitcoin-paper/active /var/lib/neobitcoin-paper/parquet /var/lib/neobitcoin-paper/event_windows /var/lib/neobitcoin-paper/delivery_outbox /var/lib/neobitcoin-paper/quarantine /var/lib/neobitcoin-paper/reports /var/lib/neobitcoin-paper/logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neobitcoin-paper

[Install]
WantedBy=multi-user.target
