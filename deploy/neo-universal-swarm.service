[Unit]
Description=Neo Universal Bot Swarm paper daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neo-trader
Group=neo-trader
WorkingDirectory=/opt/neo_trader
EnvironmentFile=/etc/neo-trader/neo-universal-swarm.env
ExecStart=/opt/neo_trader/.venv/bin/python scripts/run_neo_swarm_daemon.py --target-pairs-per-cycle 200 --cycle-interval-seconds 60 --reports-dir data/reports/neo_universal_swarm_daemon --dashboard-state data/monitoring/neo_universal_swarm_dashboard_state.json --heartbeat data/monitoring/neo_universal_swarm_heartbeat.txt
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
