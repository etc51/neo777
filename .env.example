# Copy to .env for local development.
# This scaffold must stay safe-by-default and never enable real trading.

NEO_TRADER_ENVIRONMENT=development
NEO_TRADER_LOG_LEVEL=INFO
NEO_TRADER_DRY_RUN=true
LIVE_TRADING_ENABLED=false
NEO_TRADER_LIVE_TRADING_ENABLED=false
TRADING_MODE=readonly
NEO_TRADER_TRADING_MODE=readonly
NEO_TRADER_DATA_DIR=./data
NEO_TRADER_BROKER_NAME=paper
NEO_TRADER_DASHBOARD_STATE_PATH=./data/monitoring/dashboard_state.json
NEO_TRADER_TBANK_TOKEN=
NEO_TRADER_TBANK_MODE=readonly
NEO_TRADER_TBANK_BASE_URL=
NEO_TRADER_TBANK_TIMEOUT_SECONDS=10
NEO_TRADER_TBANK_MAX_RETRIES=3
NEO_TRADER_TBANK_BACKOFF_SECONDS=0.25
